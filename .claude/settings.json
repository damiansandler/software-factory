{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(touch .claude/.build-active)",
      "Bash(rm -f .claude/.build-active)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Bash(cat .env:*)",
      "Bash(cat .env.local:*)",
      "Bash(head .env:*)",
      "Bash(head .env.local:*)",
      "Bash(tail .env:*)",
      "Bash(tail .env.local:*)",
      "Bash(less .env:*)",
      "Bash(less .env.local:*)",
      "Bash(more .env:*)",
      "Bash(more .env.local:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git push origin main -f:*)",
      "Bash(git push origin +main:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-tests.sh\""
          }
        ]
      }
    ]
  }
}
